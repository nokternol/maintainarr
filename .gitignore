# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# testing
/coverage
cypress/downloads
cypress/screenshots
cypress/videos

# next.js
/.next/
/out/

# production
/dist

# runtime config
/config/db
/config/logs
/config/settings.json

# test databases
:memory:
*.db
*.sqlite
*.sqlite3
!.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Biome
.biome-cache

# IDE
.vscode/*
!.vscode/settings.json
.idea
*.swp
*.swo
*~

# Ladle
tmp
build

#agents
# .claude is local/session state and most skills are installed, not authored here -
# ignored by default. plan-with-graph is the one skill with tracked, load-bearing
# content (the post-commit hook calls its script directly), so it's carved out.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/plan-with-graph/
# Agent Context Files
.agent/plans/
# Browser automation files
.playwright-cli
graphify-out/cost.json
graphify-out/

# Scratch/throwaway experiment write-ups - never tracked, and already excluded from the
# graphify corpus via .graphifyignore (belt and suspenders: this stops it reaching git at
# all, .graphifyignore stops it reaching the graph even if it somehow gets committed anyway).
docs/experiments/*
!docs/experiments/README.md
